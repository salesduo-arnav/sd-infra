# --- Database Configuration (Local) ---
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb

# --- Backend Configuration ---
PGHOST=postgres
PGPORT=5432
PGUSER=myuser
PGPASSWORD=mypassword
PGDATABASE=mydb

# --- App specific ---
NODE_ENV=development
PORT=3000
JWT_SECRET=JWT_SECRET

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=SECRET_REDIS_PASSWORD_IF_THERE

CORS_ORIGINS=http://app.lvh.me
COOKIE_DOMAIN=.lvh.me
ENCRYPTION_KEY=64_HEX_CHAR_ENCRYPTION_KEY
DB_SSL_CA=DB_SSL_CA

SUPERUSER_EMAILS=SUPERUSER_EMAIL1,SUPERUSER_EMAIL2

FRONTEND_URL=http://app.lvh.me

# --- SMTP Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=SMTP_USER_EMAIL
SMTP_PASS=SMTP_USER_PASSWORD
SMTP_FROM=SMTP_USER_EMAIL

# --- GCP Configuration ---
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET

# --- Stripe ---
STRIPE_SECRET_KEY=SECRET_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=SECRET_STRIPE_WEBHOOK_SECRET

# --- Ads API Integration ---
AMAZON_ADS_CLIENT_ID=SECRET_CLIENT_ID
AMAZON_ADS_CLIENT_SECRET=SECRET_CLIENT_SECRET
AMAZON_ADS_REDIRECT_URI=http://api.lvh.me/integrations/amazon-ads/callback

# --- Encryption ---
ENCRYPTION_KEY=64_HEX_CHAR_ENCRYPTION_KEY

# --- VITE Configuration ---
VITE_API_BASE_URL=http://api.lvh.me
VITE_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
VITE_STRIPE_PUBLISHABLE_KEY=STRIPE_PUBLISHABLE_KEY

# --- Internal API (Service-to-Service) ---
INTERNAL_API_KEY=GENERATE_A_STRONG_RANDOM_SECRET

# --- SP-API Integration (Seller/Vendor Central) ---
AMZN_SP_APP_ID=SECRET_SP_APP_ID
AMZN_SP_CLIENT_ID=SECRET_SP_CLIENT_ID
AMZN_SP_CLIENT_SECRET=SECRET_SP_CLIENT_SECRET
AMZN_SP_REDIRECT_URI=http://api.lvh.me/callback